# ═══════════════════════════════════════════════════════════════════════════════
# AiNxt Platform — Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Lines starting with # are comments. Remove the # to activate a setting.
# All values shown are the defaults — you only need to set what you want to change.
# ═══════════════════════════════════════════════════════════════════════════════


# ── DEPLOYMENT ─────────────────────────────────────────────────────────────────
DEPLOYMENT_MODE=local
# local  → lenient startup checks, suitable for development
# prod   → enforces JWT_SECRET, AUDIT_SIGNING_KEY, POSTGRES_PASSWORD at startup

APP_OWNER=ainxt
# Drives DB names, schema, Kafka topics, and file paths.
# Change to your org name for a custom deployment.
# e.g. APP_OWNER=acme  →  acme_memory DB, acme schema, acme.* Kafka topics

PLATFORM_NAME=AiNxt
# Human-readable name shown in the UI footer and email templates.

PLATFORM_TIMEZONE=UTC


# ── LLM PROVIDER POSTURE ───────────────────────────────────────────────────────
#
# This is the single most important setting for OSS adopters.
#
#   LLM_PROVIDER=cloud   Use Anthropic / OpenAI / Google APIs.
#                        Requires at least one of: ANTHROPIC_API_KEY,
#                        OPENAI_API_KEY, GEMINI_API_KEY.
#
#   LLM_PROVIDER=local   An assertion: every enabled model must be
#                        deployment-local (Ollama, vLLM, LiteLLM, or any
#                        OpenAI-compatible endpoint). Checked at startup.
#                        No prompts leave your network.
#                        Requires: LOCAL_LLM_BASE_URL.
#
LLM_PROVIDER=cloud


# ── LOCAL LLM SERVER ───────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=local.
# Also used for the "simple" routing tier in cloud mode (privacy floor).
#
# Examples: Ollama http://localhost:11434, vLLM http://gpu-server:8000,
# LiteLLM http://localhost:4000.
#
# Powers the "local" model that GET /v1/models advertises as
#   {"id":"local","provider":"inhouse","tag":"In-house GPU · free · private"}
# Any OpenAI-compatible server works; Ollama is the easy option:
#   ollama serve && ollama pull llama3.2
# NOTE: no trailing /v1 — gateway_local_llm.py appends it.
# Leave empty to disable the local tier. When set to a real endpoint, a request
# for model "local" is served there and will NEVER fall back to a cloud provider.
# In Docker this is rewritten to http://ollama:11434 by install.sh.
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_API_KEY=sk-local
# Set if your local server requires authentication.
# Discovered models are listed in Admin > LLM Providers; tiers pick among them.

# Model list refresh interval (seconds). The gateway caches /v1/models.
# LOCAL_MODEL_REFRESH_SECS=300


# ── CLOUD PROVIDER API KEYS ────────────────────────────────────────────────────
# Only set the keys for providers you actually use.
# You do NOT need all three — the platform routes around unavailable providers.
#
ANTHROPIC_API_KEY=
# Required for Claude models.

OPENAI_API_KEY=
# Required for GPT models and OpenAI image generation.

GEMINI_API_KEY=
# Required for Gemini models and Veo video generation.


# ── MODELS ─────────────────────────────────────────────────────────────────────
# No model names live here (Phase 8). Register providers in Admin > LLM
# Providers, then assign models in Admin > Model Governance > Tiers:
# mini, simple, medium, complex and intent-classification are required;
# image-input, image-output and video-generation if you use them.
# doctor.sh fails while a required tier is unassigned.


# ── EMBEDDING MODELS ──────────────────────────────────────────────────────────
EMBED_PROVIDER=ollama
# Which embed_svc backend actually handles /embed calls: ollama | openai | nomic.
# Read identically at index time (Codebase indexing, workers/index_worker.py)
# and query time (Workspace/Codebase-chat retrieval, models/hybrid_search.py)
# — the SAME value in both, so they can never end up using different models
# against the same document_embeddings table. Changing this after repos are
# already indexed requires re-indexing them (a different provider/model is
# not vector-comparable, even at the same dimension). Set automatically to
# whatever you pick in ./kb-setup.sh's embedding-model prompt.

OLLAMA_EMBED_MODEL=
# Embedding model served by your Ollama instance. e.g. nomic-embed-text:latest
# Used when EMBED_PROVIDER=ollama (the default).

OPENAI_EMBED_MODEL=
# OpenAI embedding model. e.g. text-embedding-3-small
# Used when EMBED_PROVIDER=openai.

NOMIC_EMBED_MODEL=
# Nomic embedding model at an OpenAI-compatible endpoint. e.g. nomic-embed-text-v1.5
# Used when EMBED_PROVIDER=nomic.

NOMIC_EMBED_DIMS=768
# Expected vector dimension. Must match the model's output dimension.

# NOMIC_EMBED_URL=
# Set to use an external/custom OpenAI-compatible embedding service instead of local Ollama.
# e.g. NOMIC_EMBED_URL=https://your-embed-service/nomicembed

# NOMIC_EMBED_API_KEY=
# Auth key for the Nomic embed service (if required).

# NOMIC_EMBED_TIMEOUT=60
# Request timeout in seconds for calls to the custom endpoint above.

# NOMIC_EMBED_BATCH=64
# Max texts per HTTP call to the custom endpoint above.

EMBED_SVC_URL=http://embed-svc:8001
# URL of the embedding microservice (services/embed_svc). Docker Compose
# default — embed-svc is a container on the same compose network, not
# reachable via "localhost" from inside the gateway container. Only use
# http://localhost:8001 for a bare-metal (non-Docker) run where both
# processes share the host's network namespace. embed-svc itself is only
# started by ./kb-setup.sh (or `docker compose --profile embed up`) — until
# then this URL isn't actually reachable, and Codebase indexing / Workspace's
# retrieval-augmented answers fail with a clear "embed service unreachable"
# message instead of hanging or silently degrading.

# EMBED_SVC_URLS=http://embed-svc-1:8001,http://embed-svc-2:8001
# Comma-separated list for multi-instance load balancing. Falls back to
# EMBED_SVC_URL (single instance) when unset.

# ── CODEBASE CHUNK ENRICHMENT (workers/index_worker.py) ──────────────────────
# Before embedding a code chunk, the indexer asks an LLM for a one-or-two
# sentence description and prepends it, so that "how is retry handled?" matches
# a chunk that implements retry without using the word. One LLM call per chunk
# per repo — the highest-volume LLM consumer in the platform.

# The model is the `simple` tier's (Admin > Model Governance > Tiers).

# ENRICH_NO_CLOUD_EGRESS=1
# Refuse to enrich through a cloud model. The prompt contains SOURCE CODE, so
# on a deployment whose `simple` tier holds a cloud model this setting is the
# difference between indexing a private repo locally and posting all of it to
# a vendor. When set and no local model can serve the tier, enrichment fails
# loudly rather than falling back — which is the intended behaviour here.

# EMBED_SVC_PORT=8001
# Host port embed-svc is published on. Only matters if 8001 collides with
# something else already running.


# ── RERANKING (Workspace / Codebase-chat retrieval) ───────────────────────────
# RERANKER_MODEL=BAAI/bge-reranker-large
# CrossEncoder model the embed-svc container loads at startup for scoring
# retrieved candidates. Falls back to plain RRF fusion (lower quality, no
# error) if it fails to load — see RERANKER_VARIANT below for the easier way
# to pick one. Set automatically by ./kb-setup.sh's reranker-model prompt.

# RERANKER_VARIANT=bge_large
# Friendly alias for RERANKER_MODEL — bge_large | bge_base | tinybert |
# jina_tiny | jina_v2 | qwen_06b | gte_modernbert. Overrides RERANKER_MODEL
# if set. An unrecognized value silently falls back to bge_large (a log
# warning, not an error) — see services/embed_svc/reranker.py's allow-list.

# RERANKER_THREADS=12
# CPU threads per rerank call.

# RERANKER_BATCH_SIZE=8
# Candidates scored per CrossEncoder.predict() call.

# RERANKER_MAX_CANDIDATES=12
# Cap on candidates sent into the reranker per query, before scoring.

# RERANKER_LOCAL_MODEL_BASE_DIR=
# Set to allow RERANKER_MODEL to point at a local directory path (air-gapped
# installs with no HuggingFace access) — must be a path under this directory.


# ── KNOWLEDGE BASE DOCUMENT PARSING ────────────────────────────────────────────
# PARSE_SVC_URL=http://embed-svc:8001
# Document-parsing endpoint (same embed-svc container). Set automatically by
# ./kb-setup.sh.

# PARSE_SVC_ENABLED=1
# Enables Docling/PaddleOCR-based parsing in embed-svc. Set automatically by
# ./kb-setup.sh.

# USE_DOCLING_PARSER=1
# Use Docling as the document parser. "0" falls back to the legacy per-format
# parsers (markitdown/pdfplumber/BeautifulSoup) with no behavior change from
# not having Docling enabled at all. Set automatically by ./kb-setup.sh.

# KB_DOC_STORAGE_PATH=/var/lib/ainxt/kb_docs
# Where uploaded Knowledge Base documents are stored — must be a
# volume-backed path, or pending/approved documents are lost on container
# recreate.


# ── CODEWIKI (browsable per-repo documentation generation) ───────────────────
# CODEWIKI_BASE_URL and CODEWIKI_API_KEY are REQUIRED for CodeWiki to work —
# it does NOT reuse ANTHROPIC_API_KEY/OPENAI_API_KEY/GEMINI_API_KEY from the
# LLM PROVIDER section above. The panel and its build engine are on by
# default (WITH_CODEWIKI=1), so requests can be submitted/approved without
# these set, but generation itself fails with a clear error until both are
# set and the gateway is restarted.
# WITH_CODEWIKI also decides whether ./install.sh starts the codewiki-worker
# container at all (it's behind docker-compose.yml's `codewiki` Compose
# profile) — declining with --without-codewiki means the image has no
# `codewiki` CLI installed, so the worker has nothing to do.
# CODEWIKI_BASE_URL=https://api.openai.com/v1
# An OpenAI-compatible /v1 chat-completions endpoint. A trailing /v1 is
# appended automatically if you omit it.
# CODEWIKI_API_KEY=
# API key for the endpoint above.
# CODEWIKI_PROVIDER=
# Optional provider override for the codewiki CLI's own `config set
# --provider`. One of: openai-compatible (the CLI's own default — correct
# for OpenAI itself and any OpenAI-compatible endpoint, including
# CODEWIKI_BASE_URL=https://api.openai.com/v1) | atlas-cloud | anthropic |
# bedrock | azure-openai | claude-code | codex. Leave unset unless you need
# one of the non-default providers — plain "openai" is NOT a valid value
# and the CLI will reject it outright.
# CodeWiki's models come from the `medium` tier.
# CODEWIKI_MAX_TOKENS_FOR_GENERATION=
# CODEWIKI_MAX_TOKENS_FOR_CLUSTERING=
# CODEWIKI_MAX_TOKEN_PER_MODULE=
# CODEWIKI_MAX_TOKEN_PER_LEAF_MODULE=
# CODEWIKI_MAX_DEPTH=
# Optional generation-size/depth tuning. Code-level defaults apply if unset.


# ── ABSTUDIO (BUILD STUDIO) MODEL SETTINGS ───────────────────────────────────
# ABStudio's models come from the registry and the tier assignments.

# Frontend build-time overrides (Vite). Set before running `npm run build`.
# Leave blank to defer to the live /llm/models catalogue at runtime.
# VITE_ABS_RECOMMENDED_MODEL=
# VITE_ABS_DEFAULT_NODE_MODEL=
# VITE_ABS_DEFAULT_NODE_PROVIDER=
# VITE_ABS_JUDGE_MODEL=

AINXT_CLI_BIN=ainxt
# CLI binary used by skill-creator eval scripts (ainxt -p).
# Override if your CLI is installed under a different name.


# ── API SURFACE ─────────────────────────────────────────────────────────────
# Model availability is the registry's (provider and model enabled, channel);
# there are no per-model flags.
# VEO_COST_PER_SECOND=0.40              # Price for a video model with none recorded

ENABLE_RAW_OPENAI_API=false
# Expose a raw /v1/chat/completions endpoint (OpenAI-compatible pass-through).


# ── MODEL BEHAVIOR TUNING ─────────────────────────────────────────────────────
# SDLC grounding charter — set to "false" to disable the SDLC system-prompt
# injection globally (useful for non-SDLC deployments or testing).
# SDLC_GROUNDING_CHARTER=true

LOCAL_LLM_TEMPERATURE=0.3
# Temperature for local LLM streaming calls (0.0–1.0).
# Set to 0.0 for deterministic reasoning models (DeepSeek-R1, Kimi, QwQ).
# Set to 0.7 for more creative/diverse outputs.

OPENAI_MAX_COMPLETION_TOKENS=8000
# Hard cap on OpenAI output tokens. Set to 0 to disable the cap.

OPENAI_REASONING_EFFORT=low
# GPT-5.x reasoning effort: none | low | medium | high | xhigh
# "low" minimises reasoning token billing for routine calls.

LLM_TIMEOUT_SEC=300
# Timeout in seconds for all LLM API calls.

CHAT_CONTEXT_USABLE_FRACTION=0.75
# Fraction of the context window filled before compaction triggers (0.0–1.0).

# ── DOCUMENT GENERATION (workers/doc_worker.py) ───────────────────────────────
# Document bodies are authored by the `complex` tier and titles by `simple`.
# A user's model pick in the chat dropdown ALWAYS wins over both — that is a
# hard requirement, not a default.

# DOC_MODEL_PROVIDER=
# Pin document generation without touching anyone's chat preference. The value
# is read two different ways:
#   * one of mini | simple | medium | complex  → GOVERNED. You are naming a
#     capability, so the tier assignment decides the model and you can change
#     it later on the Tiers screen without editing .env.
#   * a concrete model id (e.g. my-inhouse-qwen) or a legacy alias (openai-deep)
#     → honoured verbatim, bypassing governance, with a deprecation warning
#     logged once per process. Kept because it is the only way to pin a
#     deployment that has no provider the registry knows.
# Leave unset (the default) for the `complex` tier.

# DOC_TITLE_MODEL=
# Pin the model that NAMES a document. Same two readings as above. Leave unset
# for the `simple` tier — a 3-9 word title is short output that still has to
# follow instructions.

# PPT_IMAGE_PROVIDER=auto
# Images inside generated documents and slide decks. "auto" (the default) asks
# the `image-output` tier — the same assignment chat image generation uses.
# Set to "disabled" to turn document images off without un-assigning the tier;
# "gemini" or "dalle" force a provider; the model is still that provider's
# pick on the `image-output` tier.


# ── ainxt-api (headless Rust agent service) ───────────────────────────────────
# Its session model resolves from the tiers; there are no per-tier overrides.


# ── SDLC PIPELINE STAGE MODELS ────────────────────────────────────────────────
# Every SDLC stage now names a CAPABILITY and an administrator picks the model
# for it on Admin > Model Governance > Tiers:
#
#   locate, normalize, classify           → simple
#   coder, plan, implement                → complex
#   code_review                           → complex, preferring role='review'
#   manifest_validate                     → complex, from a family OTHER than
#                                           the one that wrote the plan
#
# The variables below are per-stage PINS. Each takes a TIER NAME only (a model
# id is ignored with a warning); the Tiers screen picks the model.
#
# SDLC_MODEL_LOCATE=
# SDLC_MODEL_NORMALIZE=
# SDLC_MODEL_CODER=
# SDLC_MODEL_CODE_REVIEW=
# SDLC_MODEL_MANIFEST_VALIDATE=
#
# The CLASSIFY, PLAN and IMPLEMENT phases spawn the ainxt CLI; their models
# come from the tiers (classify=simple, plan/implement=complex). A model whose
# id does not begin with claude/gpt/o1/o3/o4/gemini/local/ollama cannot be
# used by the CLI and is skipped.

# ── SDLC CLI BINARY SOURCE ─────────────────────────────────────────────────────
# sdlc-setup.sh fetches the ainxt CLI from GitHub Releases
# (npci/ainxt-cli). Only needed if that repo is private and an
# unauthenticated fetch gets a 401/404 — sdlc-setup.sh prompts for one
# interactively and saves it here itself; you only need to set this by hand
# for a non-interactive install. See docs/SDLC_CLI_SETUP.md.
# SDLC_CLI_GH_TOKEN=

# ── SDLC GOVERNANCE MODELS ────────────────────────────────────────────────────
# Concrete model id (any provider) for the governance scan reviewer / author-fix.
# Unset → the `complex` tier assignment; the reviewer additionally prefers a
# candidate tagged role='review' on the Tiers screen.
# SDLC_GOVERNANCE_REVIEW_MODEL=
# SDLC_GOVERNANCE_FIX_MODEL=


# ── CONTEXT WINDOW CONFIGURATION ──────────────────────────────────────────────
# Path to a JSON file defining context window sizes and output token reservations
# per model family (substring-matched against model names).
# The bundled config/model_context_windows.json is used by default.
# Override to add support for new model families without code changes.
# MODEL_CONTEXT_CONFIG=config/model_context_windows.json


# ── SPEND TRACKING — CUSTOM PROVIDER PATTERNS ─────────────────────────────────
# Add regex patterns to classify custom model IDs to a billing provider.
# These extend (not replace) the built-in patterns.
# SPEND_OPENAI_PATTERN_EXTRA=^nova-|^titan-
# SPEND_ANTHROPIC_PATTERN_EXTRA=
# SPEND_GEMINI_PATTERN_EXTRA=


# ── MEMORY RESIDENCY ──────────────────────────────────────────────────────────
# Rolling conversation summaries and merged long-term memories are distilled
# and long-lived, which can make them more sensitive than any single turn.
# Set this to true to require that they are served only by a model running
# inside your own infrastructure (capabilities.privacy_class =
# deployment_local), whatever the `simple` tier is otherwise assigned.
#
# This is a POLICY constraint, not a model choice: it never picks a model, it
# removes ineligible ones, and it refuses to fall back to a cloud model if no
# local one can serve the tier. Off by default — a deployment that never had
# this requirement does not acquire one on upgrade.
MEMORY_NO_CLOUD_EGRESS=false


# ── PRIVACY FLOOR ─────────────────────────────────────────────────────────────
# When enabled (default), CONFIDENTIAL/RESTRICTED/PCI_SENSITIVE data is
# automatically pinned to the local LLM — never sent to cloud providers.
# Disable only in development environments where all data is non-sensitive.
PRIVACY_FLOOR_ENFORCE=true


# ── DATABASE ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ainxt_memory
# Overrides the APP_OWNER-derived database name if set.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
# REQUIRED in prod (DEPLOYMENT_MODE=prod).

POSTGRES_SCHEMA=ainxt
# Overrides the APP_OWNER-derived schema name if set.

# pgVector — can be the same host as Postgres, or a dedicated vector DB server.
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432


# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave empty if your Redis instance has no authentication.


# ── SECURITY & SESSION ────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# REQUIRED in prod. Use a long random string (32+ chars).

JWT_EXPIRE_HOURS=24
# How long a login session token stays valid (hours). Default: 24.
# Users are logged out after this period of inactivity.

MAX_CONCURRENT_SESSIONS=5
# Maximum simultaneous login sessions per user across all devices.
# When exceeded, the oldest session is automatically evicted.
# Increase this if users work across many devices/browsers simultaneously.

SESSION_ENFORCE_STRICT=false
# true  = deny ALL requests if Redis is unreachable (fail-closed, more secure).
# false = allow requests through if Redis is down (fail-open, more available).
# Recommended: false for most deployments; true for high-security environments.

APPROVAL_AD_LEVEL=6
# AD level at or below which users can approve SDLC pipeline runs.
# Lower number = more senior. Default 6 means all standard users can approve.

AUDIT_SIGNING_KEY=change-me-in-production
# REQUIRED, every environment. Signs the immutable audit log (HMAC-SHA256).
# The value above is a placeholder and is REJECTED at startup — the platform
# will not boot until you replace it, because a signing key published in this
# repository means any audit entry can be forged and still verify.
#   openssl rand -hex 32
# install.sh generates this for you; only a hand-copied .env needs editing.

FERNET_KEY=
# 32-byte URL-safe base64 key for AES-256-GCM credential encryption.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

CKMS_ENABLED=false
# true = HSM-backed key encryption (enterprise deployments with an HSM only).


# ── STORAGE ───────────────────────────────────────────────────────────────────
AINXT_DOC_STORAGE_DIR=/var/lib/ainxt/docs
AINXT_IMAGE_STORAGE_DIR=/var/lib/ainxt/images
AINXT_UPLOAD_DOCUMENT_PATH=/var/lib/ainxt/uploads/documents

# MINIO_ENDPOINT=localhost:9000
# Object storage endpoint (host:port, no scheme). If unset/unreachable,
# core.storage falls back to local disk storage automatically.
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=


# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────
HOD_APPROVAL_ENABLED=false
# false (OSS default) — individual/OSS mode: no org chart. Approval routing
#         is admin-only, and department pickers collapse to the single value
#         "USER". Better for a solo/small install with no HR org-chart sync,
#         since a fresh database's org_tree starts empty (every department
#         picker shows nothing until you either populate org_tree or leave
#         this at false).
# true  — enterprise/HOD mode. Product/Codebase-index approval routes to the
#         submitter's Head of Department (org_tree + department_hod_mapping);
#         department pickers list real org-tree departments. Organizations
#         with a real department/HOD org chart opt in with this set to true.
# NOTE: docker-compose.yml's gateway service still falls back to
# ${HOD_APPROVAL_ENABLED:-true} if this var is left unset entirely (not just
# commented — genuinely absent from the environment) — set it explicitly to
# false here (as above) to actually get the OSS default under docker compose.

HOD_STATEMENT_LLM_ENABLED=false
# Narrate manager/HOD statements with the `medium` tier. false (default) uses
# the deterministic summary only.

EVAL_ENABLED=true
# Global LLM-as-judge evaluation kill-switch (core/evals.py). true (OSS
# default) — LLM-as-judge runs after every chat response for quality
# monitoring, out of the box. Set to false to skip all eval calls: no extra
# LLM cost, no extra latency per chat message — handy for local dev or for
# deployments that don't need quality monitoring.
# See EVAL_JUDGE_TIMEOUT if you see "judge timeout" warnings.

ENABLE_SELF_REGISTRATION=true
# Allow users to register without an admin invite.

ENABLE_FORGOT_PASSWORD=true
# Enable the password reset flow.

SHOW_TEMP_PASSWORD_IN_UI=true
# When ENABLE_FORGOT_PASSWORD=true and SMTP is NOT configured (the OSS
# default), the platform's default behaviour is to return the generated temp
# password directly in the (unauthenticated) forgot-password API response, and
# the login page shows it on screen — a single-admin OSS install with no SMTP
# would otherwise have no way to complete a reset except reading gateway
# container logs.
#
# SECURITY: POST /auth/forgot-password takes only an email address, no proof
# of ownership. With this on (the default), anyone who can reach that endpoint
# and knows (or guesses) a registered email gets a working password for that
# account. Set this to false on any deployment reachable by untrusted users —
# public-facing, or multi-tenant — where you are not the only one who can
# reach the login page. It then falls back to printing the temp password to
# the gateway console/logs only, and the login page tells the user to ask an
# administrator to check them. This never applies when SMTP is configured —
# email delivery is preferred whenever it is available.

ENABLE_GOOGLE_LOGIN=false
# Show "Continue with Google" on the sign-in and sign-up screens.
#
# Sign-in reuses the SAME Google OAuth client as the Gmail connector: the
# endpoints and the credential env-var names are read from the `gmail` row in
# ainxt.connector_definitions, so there is one place to configure Google. Only
# the requested scopes differ — sign-in asks for openid/email/profile and never
# for mailbox access.
#
# To turn this on:
#   1. Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET below.
#   2. In Google Cloud Console, add this as an ADDITIONAL authorized redirect
#      URI on that same OAuth client (the /ainxt/v1/api prefix matters — nginx
#      only proxies that path to the gateway):
#        https://<your-host>/ainxt/v1/api/auth/google/callback
#   3. Set ENABLE_GOOGLE_LOGIN=true.
#
# The button stays hidden unless the flag is true AND the credentials below are
# populated, so a half-finished setup never shows a button that cannot work.

# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are deliberately NOT set in this
# file. They go in a separate, gitignored secrets file that docker-compose
# reads directly:
#
#     .env.secrets
#     ├─ GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
#     └─ GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
#
# Identical on Windows, macOS and Linux — create the file, done. Compose loads
# it via `env_file:` on the gateway service, so the credentials arrive the same
# way from any terminal, any IDE, and from install.sh.
#
# Why not .env: a live credential should not sit in the one file everyone opens,
# edits and pastes from. Keeping it in a separate gitignored file means it is
# never on screen while you are changing an unrelated setting.
#
# Why not system environment variables: they were tried and are unreliable here.
# A process inherits its environment AT LAUNCH, so on Windows a `setx` value is
# invisible to every terminal, IDE and Docker Desktop instance that was already
# running. Any `docker compose up` from such a shell interpolates the variable
# to an empty string and silently blanks the credentials — the sign-in button
# just disappears with no error. A file has no such failure mode.
#
# To keep the secret outside the repository entirely, point at it by PATH — the
# path itself is not sensitive, so it belongs here:
#
# AINXT_SECRETS_FILE=/etc/ainxt/secrets.env          # macOS / Linux
# AINXT_SECRETS_FILE=C:/ProgramData/ainxt/secrets.env # Windows
#
# Both keys are required, and both are shared with the Gmail connector.
# Verify what Compose will actually inject:
#     docker compose config | grep -A2 env_file
# Or just run ./doctor.sh — it reports the Google sign-in configuration.

# GOOGLE_LOGIN_REDIRECT_URI=
# Optional explicit override for the sign-in callback URL. When unset it is
# derived from CONNECTOR_OAUTH_REDIRECT_BASE, falling back to PLATFORM_BASE_URL.

# GOOGLE_AUTO_PROVISION=
# Create an account on someone's first Google sign-in. Defaults to whatever
# ENABLE_SELF_REGISTRATION is set to, so closing self-registration does not
# leave Google as an open side door. Set false to allow Google sign-in only for
# users an admin has already provisioned.

# GOOGLE_POST_LOGIN_REDIRECT=/portal/
# Where the browser lands after a successful Google sign-in. The SPA is served
# under /portal/, so change this only if you have re-mounted the UI.

BUDGET_ENFORCEMENT_ENABLED=true
# Enforce per-user LLM spend limits.

KAFKA_ENABLED=true
# REQUIRED — not a feature flag you can leave off.
#
# The gateway does not write chat history, audit entries, model_usages, or
# thread/SDLC/budget/agent/Coach rows to Postgres itself. It publishes them as
# events and returns; workers/kafka_consumer.py performs the actual INSERT.
#
# With KAFKA_ENABLED=false, core/kafka_producer.py routes every event to a
# Redis list (kafka:fallback:{topic}) carrying a 7-day TTL. That list is
# drained ONLY when kafka_consumer.py starts. If no consumer ever runs, those
# events expire unread and the rows never appear — chat history, the audit log
# and spend analytics stay empty while the UI looks healthy.
#
# Set to false only for a short deliberate outage, and drain afterwards by
# starting the consumer within the 7-day window.

KAFKA_BOOTSTRAP=kafka:19092
# Comma-separated broker addresses.
#   Docker install  → kafka:19092   (the broker's INTERNAL listener)
#   Native/--local  → localhost:9092 (the EXTERNAL listener, published to host)
# install.sh writes the correct value for the mode you chose.

ENABLE_COACH=false
# Enable AiNxt Coach (usage analytics and coaching).

ENABLE_DISCUSSIONS=false
# Enable the Q&A discussions module. Requires Apache Answer running separately
# (not bundled with this repository) — see README, "Discussions (Apache Answer)".

DISCUSSIONS_ENGINE_BASE_URL=
# Where Apache Answer listens. Defaults to http://127.0.0.1:8010 when unset,
# which assumes the engine is co-located with the gateway.

ANSWER_ASSERTION_SECRET=
# Signs the server-to-server identity assertion AiNxt sends to Apache Answer.
# Generate with: openssl rand -hex 32
# Empty means the handshake fails closed and Discussions stays unavailable.

ENABLE_SLACK=false
# Enable Slack integration.

ENABLE_TEAMS=false
# Enable Microsoft Teams integration.

ENABLE_WEBHOOKS=false
# Enable outbound webhooks.

HARDBLOCK_ENABLED=false
# Enable hard-block guardrails (NeMo Guardrails PCI/PII engine).


# ── PLATFORM BASE URL ─────────────────────────────────────────────────────────
PLATFORM_BASE_URL=http://localhost:8000
# Used in email links, OAuth callbacks, and SCIM provisioning.


# ── SCM PROVIDER ──────────────────────────────────────────────────────────────
SCM_PROVIDER=github
# github | gitlab
#
# GitLab connection for the SDLC pipeline (only used when SCM_PROVIDER=gitlab).
# GITLAB_TOKEN is a Personal/Project Access Token with api + write_repository
# scope; the new routable format is glpat-<base>.<ver>.<crc> (contains dots).
# It is read from .env at runtime and never committed. Leave empty to run
# without GitLab — the SDLC pipeline then reports "no GitLab token" per run.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# ── JIRA / ATLASSIAN ─────────────────────────────────────────────────────────
# Jira site base URL (e.g. https://your-org.atlassian.net) for the Jira
# connector. This is the gateway-wide fallback: a user who sets "Jira Site URL"
# under Profile → API Token Vault overrides it for their own connection, so this
# only needs a value on a single-site deployment where everyone shares one host.
# Leave blank on a multi-site deployment and have each user set their own.
# Already passed through to the gateway/workers in docker-compose.yml.
JIRA_URL=

# ── SDLC CLI ENGINE (optional) ────────────────────────────────────────────────
# The SDLC worker runs the pipeline by spawning the native `ainxt` CLI binary
# (bind-mounted at ./bin/ainxt in docker-compose.yml). The CLI routes model
# inference DIRECTLY to Anthropic using ./bin/config.toml, whose x-api-key is
# filled from ANTHROPIC_API_KEY (above) at container startup — so set an
# Anthropic key to use the SDLC pipeline.
#
# Platform service key the CLI engine presents to internal service endpoints.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SDLC_SERVICE_API_KEY=
# CLI protocol flavor. v3 matches the shipped ./bin/ainxt binary.
SDLC_CLI_FLAVOR=v3
# Run-workspace root inside the worker container. Must be writable by appuser
# (uid 1000); the default below is. Only change it if you mount another writable
# path — the image default /opt/ainxt is root-owned and will fail the checkout.
BUILDER_WORKSPACE_ROOT=/home/appuser/workspaces
# Same root-owned-default trap as BUILDER_WORKSPACE_ROOT above, but for the
# shared build/dependency cache (pip/poetry/m2/gradle) core/config.py mounts
# at TEST_VERIFY/build time: core.config.BUILDER_CACHE_ROOT defaults to
# /opt/ainxt/build-cache, which appuser (uid 1000) cannot create, so the
# post-gate build/test step fails with "[Errno 13] Permission denied:
# '/opt/ainxt'" even after BUILDER_WORKSPACE_ROOT is fixed. Must be writable.
BUILDER_CACHE_ROOT=/home/appuser/build-cache
# Third instance of the same root-owned-default trap: core.config.BUILD_LOG_DIR
# (where sandbox/workspace_builder.py writes compile/test logs) defaults to
# /opt/ainxt/logs/builds — appuser cannot create it either. Confirmed live:
# fixing only BUILDER_CACHE_ROOT still left TEST_VERIFY failing with the same
# "[Errno 13] Permission denied: '/opt/ainxt'" until this was set too.
BUILD_LOG_DIR=/home/appuser/logs/builds


# ── OLLAMA (for embedding service) ────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# Single Ollama instance URL.

# OLLAMA_URLS=http://localhost:11434,http://localhost:11435
# Comma-separated list for multi-instance load balancing.


# ── LLM PROXY (internal, for multi-host deployments) ─────────────────────────
# When set, all cloud LLM calls are forwarded to the LLM proxy service instead
# of calling provider APIs directly. Leave empty for single-host deployments.
# LLM_PROXY_URL=http://llm-proxy-host:8003


# ── OPTIONAL MICROSERVICES ────────────────────────────────────────────────────
# Each of these is an independent, optional companion service. If unset or
# unreachable, the caller already degrades gracefully (falls back to a
# built-in default behavior instead of failing the request).
# (EMBED_SVC_URL is configured above, in the EMBEDDING MODELS section.)

# COMPRESS_SVC_URL=http://localhost:8005
# Context-compression service. Falls back to sending uncompressed context.

# TRANSLATE_SVC_URL=http://localhost:8006
# Machine-translation service (indic language support). Falls back to
# returning the original untranslated text.

# PRIVACY_SVC_URL=http://localhost:8004
# External PII/PCI classification service. Falls back to the built-in
# regex-based privacy filter.

# PRESENTON_URL=http://localhost:5001
# Presentation-generation (slides) service. Presentation generation is
# skipped/disabled when unset.


# ── LDAP (optional, direct LDAP integration) ──────────────────────────────────
# Only used when LDAP_ENABLED=true (default false).
LDAP_ENABLED=false
# LDAP_URL=<ldap>://localhost:389
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# ── PROMPT-INJECTION SCANNING ─────────────────────────────────────────────────
# ENABLE_INJECTION_SCAN defaults to TRUE in code. When it is true and
# INJECTION_SCAN_URL is empty, routers/messages_compat_router.py raises at
# import time and the gateway refuses to start:
#
#   RuntimeError: ENABLE_INJECTION_SCAN=true but INJECTION_SCAN_URL is not set.
#
# The scanner is a separate sidecar service that is not part of this repository
# and is not started by docker-compose.yml, so the default for an OSS install
# is OFF. Set this to true only once you have a scanner endpoint to point at.
ENABLE_INJECTION_SCAN=false
INJECTION_SCAN_URL=
# INJECTION_SCAN_FAIL_CLOSED=true   # block the request if the scanner is down
# INJECTION_SCAN_TIMEOUT=30


# ── OBJECT STORAGE (MinIO) — chat attachments ─────────────────────────────────
# core/storage.py defaults MINIO_ENDPOINT to localhost:9000. MinIO is NOT
# started by docker-compose.yml, so with no MinIO running the gateway logs
# repeated connection-refused retries against localhost:9000 at startup.
# Startup still completes — attachment upload/download is what stops working.
# Leave these commented out to run without attachment storage.
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=chat-attachments
# MINIO_SECURE=false


# ── AiNxt OS CONTENT (optional, cross-repo) ───────────────────────────────────
# /ainxt/v1/api/templates* serve SDLC operation templates that live in the
# SEPARATE ainxt-os repository, not this one. Without it those three endpoints
# return 503 "not available"; everything else works normally.
# Point this at a checkout of ainxt-os, or place one at ./ainxt.
# AINXT_OS_ROOT=/path/to/ainxt-os


# ── FIRST-BOOT ADMIN CREDENTIALS ──────────────────────────────────────────────
# On first boot, when the database has no users, the gateway creates
# admin@ainxt.local and prints a randomly generated password to the console ONCE.
# Set these BEFORE first boot to choose them yourself instead. Leaving them empty
# is fine — the generated password is shown in the startup output (install.sh
# captures it for you).
#
# Note: once an account exists, a *generated* password is never re-applied to it,
# so a password you change in Profile -> Security survives restarts. A value set
# explicitly here IS re-applied on every boot.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=


# ── OPTIONAL OCR ENGINE (build-time) ──────────────────────────────────────────
# Read by docker-compose.yml as a BUILD ARG, not by the application. 0 (default)
# omits PaddleOCR; the bundled rapidocr engine already does CPU OCR for scanned
# PDFs and images. See requirements-ocr.txt.
#   WITH_OCR=1 docker compose up -d --build gateway
#   ./install.sh --with-ocr
WITH_OCR=0


# ── SANDBOX / AIR-GAPPED PACKAGE MIRRORS (optional) ───────────────────────────
# Read by sandbox/sandbox_image_builder.py when the SDLC sandbox builds a
# throwaway container to run generated code. Leave unset to pull from the
# public registries; set these if the build host has no direct internet
# access and must go through internal mirrors instead.
# SANDBOX_DOCKER_REGISTRY=registry.internal.example.com
# SANDBOX_PIP_INDEX_URL=https://mirror.internal.example.com/pypi/simple
# SANDBOX_NPM_REGISTRY_URL=https://mirror.internal.example.com/npm/
# SANDBOX_MAVEN_REPO_URL=https://mirror.internal.example.com/maven/
# SANDBOX_MAVEN_REPO_USER=
# SANDBOX_MAVEN_REPO_PWD=
# SANDBOX_GO_PROXY=https://mirror.internal.example.com/go
# SANDBOX_GEM_SOURCE_URL=https://mirror.internal.example.com/rubygems/
# SANDBOX_NUGET_SOURCE_URL=https://mirror.internal.example.com/cargo/
# SANDBOX_CARGO_REGISTRY_URL=https://mirror.internal.example.com/cargo/
# SANDBOX_COMPOSER_REPO_URL=https://mirror.internal.example.com/composer/
